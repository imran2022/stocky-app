{
    "name": "stocky",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --watch",
        "clean:js": "node -e \"require('fs').rmSync('public/js',{recursive:true,force:true})\"",
        "build": "npm run clean:js && npm run build:admin && npm run build:customer-display && npm run build:realtime-sales-display && npm run build:portal && npm run build:storefront",
        "build:admin": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
        "build:customer-display": "vite build -c vite.customer-display.config.js",
        "build:realtime-sales-display": "vite build -c vite.realtime-sales-display.config.js",
        "build:portal": "vite build -c vite.portal.config.js",
        "build:storefront": "vite build -c vite.storefront.config.js",
        "vue3:build": "npm run build",
        "vue3:watch": "npm run dev"
    },
    "dependencies": {
        "@alpinejs/collapse": "^3.15.11",
        "@alpinejs/focus": "^3.15.11",
        "@ant-design/icons-vue": "^7.0.1",
        "@tabler/core": "^1.5.0",
        "@tabler/icons-webfont": "^3.46.0",
        "alpinejs": "^3.15.11",
        "ant-design-vue": "^4.2.6",
        "apexcharts": "^5.3.5",
        "bootstrap": "^4.6.2",
        "bootstrap-icons": "^1.13.1",
        "chart.js": "^4.5.1",
        "dayjs": "^1.11.21",
        "dompurify": "^3.4.12",
        "echarts": "^5.5.1",
        "echarts-gl": "^2.0.9",
        "jsbarcode": "^3.12.1",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "lucide-vue-next": "^1.0.0",
        "pinia": "^4.0.2",
        "quill": "^2.0.3",
        "qz-tray": "^2.2.4",
        "vue": "^3.5.39",
        "vue-i18n": "^11.4.2",
        "vue-router": "^4.6.4",
        "vue-select": "^4.0.0-beta.6",
        "vue3-apexcharts": "^1.8.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    },
    "devDependencies": {
        "@tailwindcss/aspect-ratio": "^0.4.2",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "@vitejs/plugin-vue": "^5.2.0",
        "autoprefixer": "^10.4.20",
        "playwright": "^1.61.1",
        "postcss": "^8.5.10",
        "sass": "^1.80.0",
        "tailwindcss": "^3.4.19",
        "vite": "^6.0.0"
    }
}
